# Optional local overrides. Copy to .env.local (gitignored) if needed.
# This repository no longer ships inference backends or Maestro API keys.

# Required for local Spark/Delta runs (run_local_pipeline) outside pytest.
# Use a long random string unique to your environment — never commit a real value.
AMBIENT_PII_SALT=replace-with-your-local-pii-salt-placeholder
